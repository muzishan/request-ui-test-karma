<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
>
    <Dialog
        id="uploaderDialog"
        draggable="true"
        contentWidth="600px"
    >
        <customHeader> 
            <Toolbar id="headerToolbar">
                <Title id="uploadHeaderTitle" level="H3" text="{i18n>uploadBatteryChargerDiscount}" />
			</Toolbar>
        </customHeader>
        <content>
            <Panel id="uploaderPanel" width="auto" class="sapUiResponsiveMargin">
                <headerToolbar>
                    <OverflowToolbar id="uploaderToolbar">
                        <Title id="uploaderPanelTitle" text="{i18n>pleaseChooseDataSourceExcelFile}"/>
                    </OverflowToolbar>
                </headerToolbar>
                <content>
                   <u:FileUploader
                        id="fileUploader"
                        name="file"
                        change=".handleUploaderValueChange"
                        fileType="xls,xlsx"
                    />
                </content>
            </Panel>
            <Panel id="resultPanel" width="auto" class="sapUiResponsiveMargin" visible="false">
                <headerToolbar>
                    <OverflowToolbar id="resultToolbar">
                        <Title id="resultPanelTitle" text="{i18n>result}"/>
                    </OverflowToolbar>
                </headerToolbar>
                <content>
                    <VBox id="resultContent">
                        <FlexBox id="successInfoBox" direction="Row" alignItems="Center" class="sapUiTinyMarginBottom ">
				            <Text id="successInfoText" text="{i18n>successfullyCreated}" class="sapSuccessfulBackground"/>
                            <Text id="successInfo" text="{uploadResultModel>/createdCount}" class="sapSuccessfulBackground sapSuccessText"/>
                        </FlexBox>
                        <FlexBox id="updatedInfoBox" direction="Row" alignItems="Center" class="sapUiTinyMarginBottom">
				            <Text id="updatedInfoText" text="{i18n>successfullyUpdated}" class="sapSuccessfulBackground"/>
                            <Text id="updatedInfo" text="{uploadResultModel>/updatedCount}" class="sapSuccessfulBackground sapSuccessText"/>                       
                        </FlexBox>
                        <FlexBox id="failedInfoBox" direction="Row" alignItems="Center" class="sapUiTinyMarginBottom">
				            <Text id="failedInfoText" text="{i18n>failedCreated}" class="sapErrorBackground"/>
                            <Text id="failedInfo" text="{uploadResultModel>/errorCount}" class="sapErrorBackground sapErrorText"/>                       
                        </FlexBox>
                        <Label id="errorErrorDetail" text="{i18n>errorDetail}"/>
                        <List
                            id="errorList"
                            items="{
                                path: 'uploadResultModel>/errorDetails'
                            }" >
                            <CustomListItem id="errorListItem">
                                <VBox class="sapUiSmallMarginBegin sapUiSmallMarginTopBottom" >
                                    <Title text="{uploadResultModel>message}" level="H6" wrapping="true"/>
					                <Label text="{uploadResultModel>target}"/>
                                </VBox>
                            </CustomListItem>
                        </List>
                    </VBox>
                </content>
            </Panel>
        </content>
        <footer>
            <Toolbar id="footerToolbar">
                <ToolbarSpacer id="footerToolbarSpacer"/>
                <Button id="upload"
                        type="Emphasized"
                        text="{i18n>upload}"
                        enabled="false"
                        press=".doUploadBatteryChargerDiscount" />
                <Button id="cancel"
                    text="{i18n>cancel}"
                    press=".closeUploadDialog"
                    ariaHasPopup="Dialog" />
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>
